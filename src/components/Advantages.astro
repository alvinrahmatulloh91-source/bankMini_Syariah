---
/**
 * ADVANTAGES SECTION
 * Redesain: Hijau & Oranye
 */

interface Props {
  data: any;
}

const { data } = Astro.props;

const icons = [
  // Syariah
  '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>',
  // Edukasi
  '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5S19.832 5.477 21 6.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>',
  // Lokasi
  '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>',
  // Bebas Admin
  '<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>'
];
---

<section id="advantages" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-green-soft text-brand-green-dark text-xs font-black uppercase tracking-wider mb-6 border border-brand-green/10">
        {data.label}
      </div>
      <h2 class="text-3xl md:text-5xl font-black text-brand-green-deep leading-tight">
        {data.headline}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {data.items.map((item: any, index: number) => (
        <div class="group p-10 bg-brand-bg rounded-[2.5rem] border border-brand-border hover:bg-brand-green-light hover:border-brand-green/20 transition-colors duration-200">
          <div class="w-20 h-20 bg-brand-green rounded-3xl flex items-center justify-center text-white mb-8 shadow-lg shadow-brand-green/20 group-hover:-translate-y-0.5 transition-transform duration-200 relative overflow-hidden">
             <!-- Aksen Oranye di dalam Ikon -->
             <div class="absolute -top-4 -right-4 w-10 h-10 bg-brand-orange/30 rounded-full blur-xl"></div>
             <Fragment set:html={icons[index]} />
          </div>
          <h4 class="text-xl font-black text-brand-green-dark mb-4 leading-tight group-hover:text-brand-green transition-colors">{item.title}</h4>
          <p class="text-brand-text-secondary font-bold leading-relaxed text-sm">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
