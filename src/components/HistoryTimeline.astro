---
/**
 * KOMPONEN TIMELINE SEJARAH
 */

interface Props {
  items: Array<{
    year: string;
    title: string;
    description: string;
  }>;
}

const { items } = Astro.props;
---

<div class="relative py-12">
  <!-- Garis Tengah Timeline -->
  <div aria-hidden="true" class="timeline-spine absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-brand-green/20 -translate-x-1/2 hidden md:block"></div>

  <div class="space-y-12">
    {items.map((item, index) => (
      <div class={`timeline-row group relative flex flex-col md:flex-row items-center gap-8 ${index % 2 !== 0 ? 'md:flex-row-reverse' : ''} reveal ${index % 2 === 0 ? 'reveal-fade-right' : 'reveal-fade-left'} stagger-${(index % 3) + 1}`} data-scroll-reveal>
        <!-- Dot Timeline -->
        <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-brand-green border-4 border-brand-green-soft rounded-full -translate-x-1/2 z-10 hidden md:block transition-transform duration-500 group-hover:scale-150" aria-hidden="true"></div>

        <!-- Konten Timeline -->
        <div class="flex-1 w-full md:w-1/2">
          <div class={`p-8 bg-white rounded-[2rem] border border-brand-border shadow-sm transition-colors duration-300 group-hover:border-brand-green/30 ${index % 2 === 0 ? 'md:text-right' : 'md:text-left'}`}>
            <span class="inline-block px-4 py-1 bg-brand-orange text-brand-green-deep text-xs font-black rounded-full mb-4">
              {item.year}
            </span>
            <h3 class="text-xl font-black text-brand-green-dark mb-3 group-hover:text-brand-green transition-colors">{item.title}</h3>
            <p class="text-brand-text-secondary font-medium leading-relaxed">{item.description}</p>
          </div>
        </div>

        <!-- Spacer untuk kolom sebelah -->
        <div class="flex-1 hidden md:block"></div>
      </div>
    ))}
  </div>
</div>
