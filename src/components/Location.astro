---
/**
 * LOCATION SECTION
 * Redesain: Hijau & Oranye
 */

interface Props {
  data: any;
  contactData: any;
}

const { data, contactData } = Astro.props;
---

<section id="location" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="flex flex-col lg:flex-row gap-16">
      <!-- Peta / Visual Lokasi -->
      <div class="flex-1 reveal reveal-fade-right reveal-clip">
        <div class="aspect-square md:aspect-video bg-brand-green-light rounded-[3rem] border-[12px] border-white shadow-2xl overflow-hidden relative group">
           <!-- Placeholder Peta -->
           <div class="reveal-mask absolute inset-0 bg-brand-green/10 flex items-center justify-center">
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-32 h-32 text-brand-green/10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
           </div>

           <!-- Pin Lokasi Animasi -->
           <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
              <div class="location-pin inline-flex h-16 w-16 items-center justify-center rounded-full border-8 border-white bg-brand-green shadow-lg">
                <span class="h-3 w-3 rounded-full bg-white"></span>
              </div>
           </div>

           <!-- Label Lokasi -->
              <div class="absolute bottom-8 left-8 right-8 p-6 bg-white rounded-2xl border border-brand-border shadow-md">
              <p class="text-xs font-black text-brand-green uppercase tracking-widest mb-2">Posisi Ruangan</p>
              <p class="text-sm font-bold text-brand-green-dark leading-relaxed">
                {data.address}
              </p>
           </div>
        </div>
      </div>

      <!-- Teks & Kontak -->
      <div class="flex-1 flex flex-col justify-center reveal reveal-fade-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-green-soft text-brand-green-dark text-xs font-black uppercase tracking-wider mb-6 border border-brand-green/10 self-start">
          {data.label}
        </div>
        <h2 class="text-3xl md:text-5xl font-black text-brand-green-deep leading-tight mb-8">
          {data.headline}
        </h2>
        <p class="text-xl text-brand-text-secondary font-medium leading-relaxed mb-10">
          {data.instruction}
        </p>

        <!-- List Kontak -->
        <div id="contact" class="space-y-6">
           <h4 class="text-sm font-black text-brand-green uppercase tracking-[0.2em] mb-4">{contactData.headline}</h4>

           <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
             {contactData.people.map((person: any, idx: number) => (
                <a
                  href={`https://wa.me/${person.phone}?text=${encodeURIComponent(contactData.whatsapp_message)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={`group reveal reveal-fade-up stagger-${idx + 1} flex items-center gap-4 p-5 bg-brand-bg rounded-[1.5rem] border border-brand-border hover:bg-brand-green hover:border-brand-green transition-colors duration-200`}
                >
                  <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-brand-green group-hover:text-brand-green-dark shadow-sm transition-transform duration-200 group-hover:-translate-y-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-[10px] text-brand-text-secondary group-hover:text-white font-black uppercase tracking-wider leading-none mb-1 transition-colors">WhatsApp</p>
                    <p class="text-sm font-black text-brand-green-dark group-hover:text-white transition-colors">{person.name}</p>
                  </div>
                </a>
             ))}
           </div>
        </div>
      </div>
    </div>
  </div>
</section>
