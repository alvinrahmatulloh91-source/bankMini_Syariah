---
import type { SiteContent } from '../data/siteContentSchema';
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: SiteContent['services'];
  items: CollectionEntry<'services'>[];
  lang: 'id' | 'en';
}

const { data, items, lang } = Astro.props;
const services = items.map(({ data: service }) => ({
  ...service,
  title: service.title[lang],
  description: service.description[lang],
  details: service.details[lang],
  image_alt: service.image_alt[lang]
})).filter((service) => service.published)
  .sort((a, b) => a.order - b.order);
const featured = services.find((service) => service.featured);
const supporting = services.filter((service) => service.id !== featured?.id);
const ctaLabel = data.cta || (lang === 'en' ? 'Learn more' : 'Pelajari lebih lanjut');
---

<section id="services" class="py-24 bg-brand-bg relative overflow-hidden" aria-labelledby="services-title">
  <div class="container mx-auto px-6">
    <header class="max-w-3xl mb-16 reveal reveal-fade-right">
      {data.label && (
        <div class="inline-flex items-center px-4 py-2 rounded-xl bg-brand-green-soft text-brand-green-dark text-xs font-black uppercase tracking-wider mb-6 border border-brand-green/10">
          {data.label}
        </div>
      )}
      <h2 id="services-title" class="text-3xl md:text-5xl font-black text-brand-green-deep leading-tight mb-6">{data.headline}</h2>
      {data.subheadline && (
        <p class="text-xl text-brand-text-secondary max-w-2xl font-medium">{data.subheadline}</p>
      )}
    </header>

    {featured && (
      <article class="service-feature reveal reveal-clip">
        <div class="service-feature__visual reveal-mask">
          {featured.image ? (
            <img src={featured.image} alt={featured.image_alt || featured.title} loading="lazy" decoding="async" />
          ) : (
            <div class="service-feature__mark" aria-hidden="true">
              {featured.icon === 'bank' ? (
                <svg viewBox="0 0 48 48" fill="none"><path d="m5 19 19-12 19 12H5ZM9 22v15m10-15v15m10-15v15m10-15v15M5 41h38M3 45h42" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              ) : (
                <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2"/><path d="M29 18c-1.2-1.3-2.8-2-5-2-3 0-5 1.5-5 4s2 3.5 5 4 5 1.5 5 4-2 4-5 4c-2 0-4-.8-5.5-2.3M24 12v24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              )}
            </div>
          )}
        </div>
        <div class="service-feature__copy">
          {data.label && <p class="service-kicker">{data.label}</p>}
          <h3>{featured.title}</h3>
          {featured.description && <p class="service-description">{featured.description}</p>}
          {featured.details && featured.details.length > 0 && (
            <ul class="service-details">
              {featured.details.map((detail) => <li>{detail}</li>)}
            </ul>
          )}
          <a class="service-link" href="#contact">{ctaLabel}<span aria-hidden="true">→</span></a>
        </div>
      </article>
    )}

    {supporting.length > 0 && (
      <div class="service-list">
        {supporting.map((service) => (
          <article class="service-row reveal reveal-fade-up">
            <div class="service-row__icon" aria-hidden="true">
              {service.image ? <img src={service.image} alt={service.image_alt || service.title} loading="lazy" decoding="async" /> : <span>{service.icon === 'savings' ? '01' : service.icon === 'transfer' ? '02' : '03'}</span>}
            </div>
            <div class="service-row__copy">
              <h3>{service.title}</h3>
              {service.description && <p>{service.description}</p>}
              {service.details && service.details.length > 0 && <ul>{service.details.map((detail) => <li>{detail}</li>)}</ul>}
            </div>
            <a href="#contact" aria-label={`${ctaLabel}: ${service.title}`}>→</a>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .service-feature { display:grid; grid-template-columns:minmax(15rem,.85fr) 1.15fr; min-height:25rem; overflow:hidden; background:#fff; border:1px solid var(--color-brand-border); border-top:4px solid var(--color-brand-orange); }
  .service-feature__visual { display:grid; min-height:20rem; place-items:center; background:var(--color-brand-green-deep); }
  .service-feature__visual img { width:100%; height:100%; min-height:inherit; object-fit:cover; }
  .service-feature__mark { display:grid; width:100%; height:100%; min-height:20rem; place-items:center; color:#b9d8c4; background:linear-gradient(145deg,#105c38,#0b3d2e); }
  .service-feature__mark svg { width:5rem; height:5rem; }
  .service-feature__copy { padding:clamp(1.5rem,4vw,3.5rem); }
  .service-kicker { color:var(--color-brand-green); font-size:.7rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
  .service-feature h3,.service-row h3 { margin-top:.7rem; color:var(--color-brand-green-deep); font-size:clamp(1.7rem,3vw,2.5rem); font-weight:800; letter-spacing:-.035em; line-height:1.15; }
  .service-description,.service-row__copy > p { margin-top:.8rem; color:var(--color-brand-text-secondary); font-weight:600; line-height:1.7; }
  .service-details { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem 1.25rem; margin-top:1.5rem; }
  .service-details li { position:relative; padding-left:1.1rem; color:var(--color-brand-text-primary); font-size:.85rem; font-weight:700; line-height:1.5; }
  .service-details li::before { content:''; position:absolute; left:0; top:.55em; width:.4rem; height:.4rem; background:var(--color-brand-orange); }
  .service-link { display:inline-flex; align-items:center; gap:.8rem; margin-top:1.6rem; color:var(--color-brand-green-dark); font-size:.85rem; font-weight:800; }
  .service-link span { color:var(--color-brand-orange-dark); transition:transform 180ms ease; }
  .service-link:hover span { transform:translateX(3px); }
  .service-list { margin-top:1.25rem; border-top:1px solid var(--color-brand-border); }
  .service-row { display:grid; grid-template-columns:4.5rem 1fr 2.5rem; gap:1.25rem; align-items:start; padding:1.5rem 0; border-bottom:1px solid var(--color-brand-border); }
  .service-row__icon { display:grid; width:3.5rem; height:3.5rem; place-items:center; border-radius:.75rem; background:var(--color-brand-green-soft); color:var(--color-brand-green-dark); font-weight:800; overflow:hidden; }
  .service-row__icon img { width:100%; height:100%; object-fit:cover; }
  .service-row__copy > ul { display:flex; flex-wrap:wrap; gap:.5rem 1rem; margin-top:.6rem; }
  .service-row__copy > ul li { color:var(--color-brand-text-secondary); font-size:.8rem; font-weight:600; }
  .service-row > a { display:grid; width:2.5rem; height:2.5rem; place-items:center; border-radius:.5rem; border:1px solid var(--color-brand-border); color:var(--color-brand-green-dark); font-weight:800; transition:background-color 180ms ease,color 180ms ease; }
  .service-row > a:hover { background:var(--color-brand-green-dark); color:#fff; }
  @media (max-width:767px) {
    .service-feature { grid-template-columns:1fr; }
    .service-details { grid-template-columns:1fr; }
    .service-row { grid-template-columns:1fr; gap:.75rem; }
    .service-row > a { justify-self:start; }
  }
</style>
