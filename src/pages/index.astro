---
import MainLayout from '@layouts/MainLayout.astro';
import Navbar from '@components/Navbar.astro';
import Hero from '@components/Hero.astro';
import About from '@components/About.astro';
import Services from '@components/Services.astro';
import ServiceProcess from '@components/ServiceProcess.astro';
import Advantages from '@components/Advantages.astro';
import OperationInfo from '@components/OperationInfo.astro';
import FAQ from '@components/FAQ.astro';
import Location from '@components/Location.astro';
import Footer from '@components/Footer.astro';
import RoomGallery from '@components/RoomGallery.astro';
import ActivityDocumentation from '@components/ActivityDocumentation.astro';
import { getCollection } from 'astro:content';
import { siteContent } from '@data/siteContent';
import { validateContentMedia } from '@data/validateContentMedia';
import { validatePairedContent } from '@data/validatePairedContent';
const data = siteContent.id;
const roomGallery = await getCollection('roomGallery');
const activityDocumentation = await getCollection('activityDocumentation');
const services = await getCollection('services');
const faqs = await getCollection('faqs');
validatePairedContent(services.map((item) => item.data), faqs.map((item) => item.data));
validateContentMedia([
  ...services.map((item) => item.data.image),
  ...roomGallery.map((item) => item.data.image),
  ...activityDocumentation.map((item) => item.data.image)
]);
---

<MainLayout
  title={`${data.branding.organization_name} - Bank Mini Syariah ${data.branding.school_name}`}
  description={data.hero.subheadline}
  lang="id"
>
  <Navbar data={data.nav} branding={data.branding} lang="id" />

  <main id="main-content" tabindex="-1">
    <Hero data={data.hero} lang="id" />
    <About data={data.about} />
    <Services data={data.services} items={services} lang="id" />
    <RoomGallery data={data.space} address={data.location.address} lang="id" items={roomGallery} />
    <ActivityDocumentation items={activityDocumentation} lang="id" />
    <ServiceProcess data={data.process} />
    <Advantages data={data.advantages} />
    <OperationInfo data={data.operation} />
    <FAQ data={data.faq} items={faqs} lang="id" />
    <Location data={data.location} contactData={data.contact} lang="id" />
  </main>

  <Footer data={data.footer} navData={data.nav} branding={data.branding} contactData={data.contact} lang="id" />
</MainLayout>
